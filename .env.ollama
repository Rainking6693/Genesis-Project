# Genesis 2025 - Ollama Optimization Environment Variables
# Source this file or add to ~/.bashrc or system environment
#
# Performance Impact:
#   Context Caching: +40% speed
#   Batch Mode: +200% throughput (via LiteLLM)
#   Layer Offloading: No unload delays
#   Fail Router: Auto-escalate <70% scores

# Context Caching - Reuse KV cache for repeated prompts
OLLAMA_CONTEXT_CACHING=1

# Layer Offloading - Keep model resident in memory
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_LAYERS_OFFLOAD=12

# Parallel Processing
OLLAMA_NUM_PARALLEL=4

# Keep model loaded for 30 minutes of inactivity
OLLAMA_KEEP_ALIVE=30m

# GPU Settings (adjust based on your hardware)
# OLLAMA_GPU_LAYERS=35
# CUDA_VISIBLE_DEVICES=0

# Memory Settings
# OLLAMA_MODELS=/path/to/models
