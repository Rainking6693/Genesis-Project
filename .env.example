# Genesis Pipeline - Environment Variables
# =========================================
# Copy this file to .env and fill in your values
#
# MINIMAL SETUP: Only 4 keys needed for full automation!
# =====================================================

# ============================================================
# TIER 1: REQUIRED (Minimum for full automation)
# ============================================================

# Claude AI (Primary orchestrator) - REQUIRED
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Domain Registration (Porkbun - user's preferred registrar) - REQUIRED
PORKBUN_API_KEY=pk1_your-key-here
PORKBUN_SECRET_KEY=sk1_your-secret-here

# Payment Processing (Stripe) - REQUIRED for billing
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here

# GitHub (Deployment) - REQUIRED
GITHUB_TOKEN=ghp_your-token-here
GITHUB_USERNAME=your-github-username

# ============================================================
# TIER 2: OPTIONAL - Open Source Alternatives Available
# ============================================================

# OpenAI (Backup LLM - NOT required, Claude handles everything)
# OPENAI_API_KEY=sk-your-key-here

# Gemini (QA Agent via Roundtable - optional)
# GEMINI_API_KEY=AIza-your-key-here

# ============================================================
# TIER 3: DEPLOYMENT PLATFORMS (Pick ONE)
# ============================================================

# GitHub Pages (DEFAULT - FREE, best for static sites)
DEFAULT_DEPLOY_PLATFORM=github-pages

# Railway (For backends only if needed)
# RAILWAY_TOKEN=your-railway-token

# Render (Alternative to Railway)
# RENDER_API_KEY=your-render-key

# ============================================================
# TIER 4: MONITORING & ANALYTICS (Open Source Available)
# ============================================================

# Plausible Analytics (Self-hosted alternative to Google Analytics)
# PLAUSIBLE_URL=https://plausible.your-domain.com
# PLAUSIBLE_SITE_ID=your-site-id

# Prometheus (Self-hosted monitoring)
# PROMETHEUS_URL=http://localhost:9090

# ============================================================
# GENESIS CONFIGURATION
# ============================================================

# Environment
GENESIS_ENV=production

# Cost Controls
LARGE_BILL_THRESHOLD=100.0
AP2_AUTO_APPROVE_DOMAINS=false

# Local LLM (Ollama - FREE)
OLLAMA_HOST=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b

# ============================================================
# LEGACY / MIGRATION (Name.com → Porkbun)
# ============================================================
# These are deprecated - use Porkbun keys above instead
# NAMECOM_API_USERNAME=deprecated
# NAMECOM_API_TOKEN=deprecated
