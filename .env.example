# Genesis Environment Configuration - TEMPLATE
# ============================================
# SECURITY: This file contains NO real secrets
# Copy to .env and fill in your actual values
# NEVER commit .env to Git (only commit .env.example)
#
# Created: November 8, 2025
# Owner: Quinn (Security Specialist)

# ============================================
# CORE ENVIRONMENT
# ============================================
GENESIS_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# AI MODEL API KEYS (REQUIRED)
# ============================================
# Get your keys from:
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - Google: https://makersuite.google.com/app/apikey
# - DeepSeek: https://platform.deepseek.com/
# - Mistral: https://console.mistral.ai/

ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEEPSEEK_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MISTRAL_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# GOOGLE CLOUD / VERTEX AI (OPTIONAL)
# ============================================
# Path to your service account JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Enable Vertex AI routing (set to false if not using)
ENABLE_VERTEX_AI=false

# Fine-tuned model endpoints (if you have them)
# Format: projects/PROJECT_ID/locations/LOCATION/models/MODEL_ID@VERSION
GENESIS_SUPPORT_MODEL=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL@1
GENESIS_ANALYST_MODEL=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL@1
GENESIS_LEGAL_MODEL=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL@1
GENESIS_CONTENT_MODEL=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL@1
GENESIS_SECURITY_MODEL=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL@1

# ============================================
# AZURE AI CONFIGURATION (OPTIONAL)
# ============================================
# Get from: https://portal.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_AI_PROJECT_PATH=/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# ============================================
# PIPELEX CONFIGURATION (OPTIONAL)
# ============================================
# Get from: https://pipelex.ai/
PIPELEX_INFERENCE_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# GENESIS A2A SERVICE AUTHENTICATION (REQUIRED)
# ============================================
# Generate with: openssl rand -base64 32
A2A_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# WALTZRL SAFETY CONFIGURATION
# ============================================
ENABLE_WALTZRL=true
ENABLE_WALTZRL_SAFETY_BENCHMARKS=true
WALTZRL_FEEDBACK_MODEL=gpt-4o
WALTZRL_CONVERSATION_MODEL=gpt-4o
WALTZRL_COOPERATION_LAMBDA=0.3
WALTZRL_SAFETY_THRESHOLD=0.9
WALTZRL_BLOCK_ON_FAILURE=false

# ============================================
# MULTI-AGENT EVOLVE
# ============================================
ENABLE_MULTI_AGENT_EVOLVE=true

# ============================================
# FP16 TRAINING CONFIGURATION
# ============================================
# Enable if you have NVIDIA GPU with CUDA support
ENABLE_FP16_TRAINING=false
PERFORMANCE_OPTIMIZATIONS_ENABLED=true

# ============================================
# COMPUTER USE BACKEND
# ============================================
COMPUTER_USE_BACKEND=gemini
USE_DOM_PARSING=false
USE_OPENHANDS=false

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local MongoDB
MONGODB_URI=mongodb://localhost:27017/genesis

# For MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/genesis

# Redis (optional - for caching)
REDIS_URI=redis://localhost:6379

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_FLAGS_CONFIG=config/feature_flags.json
ORCHESTRATION_ENABLED=true
SECURITY_HARDENING_ENABLED=true
LLM_INTEGRATION_ENABLED=true
ERROR_HANDLING_ENABLED=true
FORCE_CLOUD_LLM=true

# ============================================
# DAAO COST OPTIMIZATION
# ============================================
DAAO_ENABLED=true
DAAO_BUDGET_CONSCIOUS=true

# ============================================
# SECURITY CONFIGURATION
# ============================================
PROMPT_SHIELD_ENABLED=true
AGENT_AUTH_ENABLED=true
TASK_COUNTER_ENABLED=true
SANDBOX_ENABLED=true

# ============================================
# ERROR HANDLING & CIRCUIT BREAKER
# ============================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SEC=60
RETRY_MAX_ATTEMPTS=3

# ============================================
# OBSERVABILITY (OpenTelemetry)
# ============================================
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=genesis-orchestrator
OTEL_TRACE_SAMPLE_RATE=1.0
LOG_FORMAT=json

# ============================================
# HEALTH CHECKS & MONITORING
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SEC=30
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================
# MONITORING STACK (Optional)
# ============================================
# Only needed if running Grafana/Prometheus locally
GRAFANA_ADMIN_PASSWORD=your_secure_password_here
PROMETHEUS_PASSWORD=your_secure_password_here
ALERTMANAGER_PASSWORD=your_secure_password_here

# ============================================
# DEPLOYMENT TOKENS (OPTIONAL)
# ============================================
# Only needed if deploying from local machine
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=team_XXXXXXXXXXXXXXXXXXXX

# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# ANALYTICS & MARKETING (OPTIONAL)
# ============================================
# Mixpanel: https://mixpanel.com/
MIXPANEL_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Sentry: https://sentry.io/
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXXXXXXXXXXXXXXX.ingest.us.sentry.io/XXXXXXXXX

# Mailgun: https://www.mailgun.com/
MAILGUN_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXX-XXXXXXXX

# Twitter: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# STRIPE PAYMENT PROCESSING (OPTIONAL)
# ============================================
# IMPORTANT: Use TEST keys for development!
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# For production (DO NOT use in development):
# STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXX
# STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXX

# ============================================
# PRODUCTION SAFETY FLAGS
# ============================================
DEV_MODE=false
LOG_SENSITIVE_DATA=false

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys (required ones marked above)
# 3. NEVER commit .env to Git (it's in .gitignore)
# 4. For Docker secrets, use secrets/ directory instead
# 5. Rotate keys every 90 days minimum
#
# See docs/DEPLOYMENT_GUIDE.md for full setup instructions
